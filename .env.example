# Minecraft 26.2 server
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=Eva
MC_AUTH=offline
MC_VERSION=26.2

# Qwen / OpenAI-compatible API
LLM_BASE_URL=http://192.168.0.65:8000/v1
LLM_MODEL=qwen38-27b
LLM_API_KEY=EMPTY
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.30

# Autonomous agent
AGENT_AUTONOMOUS=true
AGENT_TICK_MS=5000
AGENT_MAX_ACTIONS=6
AGENT_MAX_HISTORY=24
# If Qwen returns no physical action for this many idle cycles, Eva wanders.
AGENT_MAX_IDLE_CYCLES=2
AGENT_ADMIN_USERS=dk98174003
HOME_POSITION=54,108,34

# World policy
CREATIVE_FOR_ALL=true

# Physical movement
MOVE_MAX_SECONDS=10
MOVE_STEP_MS=200
MOVE_MAX_DROP=3

# RCON is for server administration, fallback tellraw, and optionally giving
# Eva building materials. It is NOT used to place construction blocks.
RCON_ENABLED=true
RCON_CONTAINER=minecraft
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
RCON_PROPERTIES_PATHS=/data/minecraft_data/server.properties,/data/server.properties,/server.properties,/minecraft/server.properties

# Physical Mineflayer building guardrails
BUILD_MAX_BLOCKS=1200
BUILD_MAX_DISTANCE=48
BUILD_REACH=4.2
BUILD_MOVE_RANGE=1.1
BUILD_MOVE_MAX_SECONDS=8
BUILD_PLACEMENT_DELAY_MS=90
BUILD_MAX_PLACEMENT_PASSES=5
BUILD_MIN_SITE_SCORE=0.72
# true = RCON may run /give so Eva can equip materials. It still never uses
# setblock/fill for construction.
BUILD_RCON_PROVISION=true
