# Minecraft 26.2 server
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=Eva
MC_AUTH=offline
MC_VERSION=26.2

# Qwen / OpenAI-compatible API
LLM_BASE_URL=http://192.168.0.65:8000/v1
LLM_MODEL=qwen38-27b
LLM_API_KEY=EMPTY
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.45

# Autonomous agent
AGENT_AUTONOMOUS=true
AGENT_TICK_MS=5000
AGENT_MAX_ACTIONS=4
AGENT_MAX_HISTORY=24
AGENT_ADMIN_USERS=dk98174003
HOME_POSITION=54,108,34

# World policy. Eva sets the default game mode to Creative, updates all online
# players on spawn, and switches newly joined players to Creative.
CREATIVE_FOR_ALL=true

# Movement. Eva physically walks; these are safety caps for one action.
MOVE_MAX_SECONDS=8
MOVE_STEP_MS=250
MOVE_MAX_DROP=3

# RCON is used for reliable system chat, world policy, and building.
RCON_ENABLED=true
RCON_CONTAINER=minecraft
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
RCON_PROPERTIES_PATHS=/data/minecraft_data/server.properties,/data/server.properties,/server.properties,/minecraft/server.properties

# Building guardrails
BUILD_MAX_BLOCKS=600
BUILD_MAX_DISTANCE=32
